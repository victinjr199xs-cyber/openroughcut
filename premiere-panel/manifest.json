{
  "manifestVersion": 5,
  "id": "io.github.openroughcut.panel",
  "name": "OpenRoughCut",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "openroughcut.panel",
      "label": { "default": "OpenRoughCut" },
      "minimumSize": { "width": 260, "height": 360 },
      "preferredDockedSize": { "width": 300, "height": 520 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": { "domains": ["http://127.0.0.1:8765"] }
  }
}
